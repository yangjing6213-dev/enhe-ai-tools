generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  disabled
}

enum PlanStatus {
  active
  disabled
}

enum MembershipStatus {
  active
  expired
  cancelled
}

enum ToolType {
  software
  online
  skill_learning
  ai_skill
  ai_workflow
}

enum AiWorkflowBatchStatus {
  queued
  running
  completed
  partial
  failed
  paused
}

enum AiWorkflowCandidateStatus {
  discovered
  downloading
  reviewing
  validated
  rejected
  failed
  pending_pricing
  published
}

enum AiWorkflowPriceDecision {
  paid
  free
}

enum PublishStatus {
  draft
  published
  offline
}

enum PaymentMethod {
  alipay
  wechat
}

enum OrderStatus {
  pending_payment
  pending_review
  paid
  activated
  rejected
  cancelled
  refunded
}

enum PaymentTransactionStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentRefundState {
  requested
  dispatching
  provider_succeeded
  finalized
  finalize_retry
  provider_rejected
  ambiguous
}

enum OrderType {
  vip
  software_download
  seo_audit_credit
  seo_audit_monitoring
}

enum SeoAuditRunStatus {
  queued
  running
  completed
  failed
  cancel_requested
  cancelled
}

enum SeoAuditRunKind {
  free
  professional
  deep
  recheck
  scheduled
}

enum SeoAuditSubscriptionStatus {
  active
  paused
  expired
  refunded
}

enum SeoAuditCadence {
  weekly
  biweekly
  monthly
}

enum SeoAuditEmailOutboxStatus {
  pending
  sending
  sent
  discarded
}

enum RefundStatus {
  pending
  completed
  rejected
}

enum ProofReviewStatus {
  not_submitted
  pending
  approved
  rejected
}

enum CommentStatus {
  pending
  approved
  rejected
  deleted
}

enum ForumCategory {
  question
  experience
  workflow
  showcase
}

enum ForumContentStatus {
  pending
  approved
  rejected
}

enum ForumReportStatus {
  pending
  resolved
}

enum ContentStatus {
  active
  disabled
}

enum DevelopmentVersionStatus {
  planned
  active
  released
  archived
}

enum DevelopmentItemStatus {
  completed
  partial
  not_started
  recommended
}

enum DevelopmentPriority {
  high
  medium
  low
}

enum ProductReleaseStatus {
  planned
  active
  released
  archived
}

enum NewsStatus {
  draft
  published
  archived
}

enum ProductDemoStatus {
  draft
  published
  archived
}

enum ProductDemoCategory {
  software
  skill_learning
  account_service
}

enum AiTrendBriefingStatus {
  draft
  published
  archived
}

enum GeoPlatformRegion {
  global
  china
}

enum GeoProviderMode {
  api
  manual_browser
  search_console
  bing_webmaster
}

enum GeoQueryStatus {
  active
  paused
}

enum GeoRunStatus {
  pending
  completed
  failed
}

enum GeoRecommendationStatus {
  open
  planned
  done
  dismissed
}

model User {
  id                    String                 @id @default(cuid())
  email                 String?                @unique
  phone                 String?                @unique
  passwordHash          String                 @map("password_hash")
  googleSubject         String?                @unique @map("google_subject")
  nickname              String?
  avatar                String?
  role                  UserRole               @default(user)
  status                UserStatus             @default(active)
  isTestData            Boolean                @default(false) @map("is_test_data")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  memberships           Membership[]
  orders                Order[]
  paymentProofs         PaymentProof[]         @relation("ProofOwner")
  reviewedProofs        PaymentProof[]         @relation("ProofReviewer")
  comments              Comment[]
  downloadLogs          DownloadLog[]
  toolUsageLogs         ToolUsageLog[]
  analyticsEvents       AnalyticsEvent[]
  toolPurchases         ToolPurchase[]
  aiWorkflowFavorites   AiWorkflowFavorite[]
  aiWorkflowReviews     AiWorkflowReview[]
  aiWorkflowDownloadEvents AiWorkflowDownloadEvent[]
  aiWorkflowVersionPurchases AiWorkflowVersionPurchase[]
  aiWorkflowPriceApprovals AiWorkflowCandidate[] @relation("AiWorkflowPriceApprover")
  vipAdjustments        VipAdjustmentLog[]     @relation("VipAdjustmentTarget")
  vipOperations         VipAdjustmentLog[]     @relation("VipAdjustmentAdmin")
  refundRecords         OrderRefundRecord[]    @relation("RefundAdmin")
  refundRequests        OrderRefundRecord[]    @relation("RefundRequester")
  adminAuditLogs        AdminAuditLog[]        @relation("AdminAuditLogs")
  sessions              Session[]
  notifications         Notification[]
  newsletterEmail       String?                @map("newsletter_email")
  acceptEmailUpdates    Boolean                @default(true) @map("accept_email_updates")
  newsFavorites         NewsArticleFavorite[]
  newsLikes             NewsArticleLike[]
  toolLikes             ToolLike[]
  forumPosts            ForumPost[]              @relation("ForumPostAuthor")
  forumReplies          ForumReply[]             @relation("ForumReplyAuthor")
  forumLikes            ForumLike[]
  forumBookmarks        ForumBookmark[]
  forumShares           ForumShare[]
  forumReports          ForumReport[]            @relation("ForumReportAuthor")
  seoAuditProjects      SeoAuditProject[]
  seoAuditRuns          SeoAuditRun[]
  seoAuditCredits       SeoAuditCredit[]
  seoAuditSubscriptions SeoAuditSubscription[]

  @@map("users")
}

model VipPlan {
  id            String       @id @default(cuid())
  name          String
  durationDays  Int          @map("duration_days")
  price         Decimal      @db.Decimal(10, 2)
  originalPrice Decimal?     @map("original_price") @db.Decimal(10, 2)
  description   String?
  isRecommended Boolean      @default(false) @map("is_recommended")
  status        PlanStatus   @default(active)
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  memberships   Membership[]
  orders        Order[]

  @@map("vip_plans")
}

model Membership {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  planId     String?          @map("plan_id")
  vipType    String           @map("vip_type")
  startTime  DateTime         @map("start_time")
  endTime    DateTime?        @map("end_time")
  isLifetime Boolean          @default(false) @map("is_lifetime")
  status     MembershipStatus @default(active)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  user       User             @relation(fields: [userId], references: [id])
  plan       VipPlan?         @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@map("memberships")
}

model ToolCategory {
  id          String        @id @default(cuid())
  name        String
  type        ToolType
  description String?
  sortOrder   Int           @default(0) @map("sort_order")
  status      ContentStatus @default(active)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  tools       Tool[]

  @@index([type, status])
  @@map("tool_categories")
}

model Tool {
  id                    String          @id @default(cuid())
  name                  String
  englishName           String?         @map("english_name")
  slug                  String          @unique
  type                  ToolType
  categoryId            String?         @map("category_id")
  shortDescription      String          @map("short_description")
  content               String
  coverImage            String?         @map("cover_image")
  screenshots           String[]        @default([])
  videoUrl              String?         @map("video_url")
  videoTitle            String?         @map("video_title")
  videoDescription      String?         @map("video_description")
  videoUrl2             String?         @map("video_url_2")
  videoTitle2           String?         @map("video_title_2")
  videoDescription2     String?         @map("video_description_2")
  videoUrl3             String?         @map("video_url_3")
  videoTitle3           String?         @map("video_title_3")
  videoDescription3     String?         @map("video_description_3")
  version               String?
  systemRequirement     String?         @map("system_requirement")
  supportedAgents       String[]        @default([]) @map("supported_agents")
  isVipRequired         Boolean         @default(true) @map("is_vip_required")
  isDownloadPaid        Boolean         @default(false) @map("is_download_paid")
  isDownloadLinkVipOnly Boolean         @default(true) @map("is_download_link_vip_only")
  isHomeRecommended     Boolean         @default(false) @map("is_home_recommended")
  downloadPrice         Decimal         @default(0) @map("download_price") @db.Decimal(10, 2)
  onlineUrl             String?         @map("online_url")
  downloadFileId        String?         @unique @map("download_file_id")
  downloadCount         Int             @default(0) @map("download_count")
  usageCount            Int             @default(0) @map("usage_count")
  status                PublishStatus   @default(draft)
  sortOrder             Int             @default(0) @map("sort_order")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  category              ToolCategory?   @relation(fields: [categoryId], references: [id])
  files                 File[]          @relation("ToolFiles")
  downloadFile          File?           @relation("PrimaryDownload", fields: [downloadFileId], references: [id])
  tutorials             Tutorial[]
  comments              Comment[]
  downloadLogs          DownloadLog[]
  likes                 ToolLike[]
  toolUsageLogs         ToolUsageLog[]
  orders                Order[]
  purchases             ToolPurchase[]
  priceSpecs            ToolPriceSpec[]
  tagLinks              ToolTagLink[]
  faqs                  ToolFaq[]
  changelogs            ToolChangelog[]
  productDemos          ProductDemo[]
  aiWorkflowCandidate   AiWorkflowCandidate?
  aiWorkflowFavorites   AiWorkflowFavorite[]
  aiWorkflowReviews     AiWorkflowReview[]
  aiWorkflowDownloadEvents AiWorkflowDownloadEvent[]
  aiWorkflowVersionPurchases AiWorkflowVersionPurchase[]

  @@index([type, status])
  @@index([isHomeRecommended, status, sortOrder])
  @@map("tools")
}

model ToolLike {
  id        String   @id @default(cuid())
  toolId    String   @map("tool_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolId, userId])
  @@index([userId, createdAt])
  @@map("tool_likes")
}

model ProductDemo {
  id                 String              @id @default(cuid())
  title              String
  slug               String              @unique
  description        String
  category           ProductDemoCategory
  tags               String[]            @default([])
  coverImage         String              @map("cover_image")
  coverAlt           String              @map("cover_alt")
  videoUrl           String?             @map("video_url")
  videoDuration      String?             @map("video_duration")
  uploadDate         DateTime?           @map("upload_date")
  transcript         String?
  faq                Json                @default("[]")
  productType        String?             @map("product_type")
  relatedProductId   String?             @map("related_product_id")
  relatedProductSlug String?             @map("related_product_slug")
  relatedProductUrl  String?             @map("related_product_url")
  demoUrl            String?             @map("demo_url")
  tutorialUrl        String?             @map("tutorial_url")
  isFeaturedOnHome   Boolean             @default(false) @map("is_featured_on_home")
  sortOrder          Int                 @default(0) @map("sort_order")
  status             ProductDemoStatus   @default(draft)
  seoTitle           String?             @map("seo_title")
  seoDescription     String?             @map("seo_description")
  canonicalUrl       String?             @map("canonical_url")
  publishedAt        DateTime?           @map("published_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  relatedProduct     Tool?               @relation(fields: [relatedProductId], references: [id], onDelete: SetNull)

  @@index([status, isFeaturedOnHome, sortOrder])
  @@index([category, status, sortOrder])
  @@index([relatedProductId])
  @@map("product_demos")
}

model ToolTag {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  color       String?
  description String?
  status      ContentStatus @default(active)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  toolLinks   ToolTagLink[]

  @@map("tool_tags")
}

model ToolTagLink {
  id     String  @id @default(cuid())
  toolId String  @map("tool_id")
  tagId  String  @map("tag_id")
  tool   Tool    @relation(fields: [toolId], references: [id])
  tag    ToolTag @relation(fields: [tagId], references: [id])

  @@unique([toolId, tagId])
  @@map("tool_tag_links")
}

model ToolFaq {
  id        String        @id @default(cuid())
  toolId    String        @map("tool_id")
  question  String
  answer    String
  status    ContentStatus @default(active)
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  tool      Tool          @relation(fields: [toolId], references: [id])

  @@index([toolId, status])
  @@map("tool_faqs")
}

model ToolChangelog {
  id          String        @id @default(cuid())
  toolId      String        @map("tool_id")
  version     String
  title       String
  content     String
  releaseDate DateTime?     @map("release_date")
  status      ContentStatus @default(active)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  tool        Tool          @relation(fields: [toolId], references: [id])

  @@index([toolId, status])
  @@map("tool_changelogs")
}

model ToolPriceSpec {
  id        String         @id @default(cuid())
  toolId    String         @map("tool_id")
  name      String
  price     Decimal        @db.Decimal(10, 2)
  sortOrder Int            @default(0) @map("sort_order")
  status    ContentStatus  @default(active)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  tool      Tool           @relation(fields: [toolId], references: [id], onDelete: Restrict)
  orders    Order[]
  purchases ToolPurchase[]

  @@index([toolId, status, sortOrder])
  @@map("tool_price_specs")
}

model File {
  id            String        @id @default(cuid())
  toolId        String?       @map("tool_id")
  fileName      String        @map("file_name")
  filePath      String        @map("file_path")
  fileUrl       String?       @map("file_url")
  fileSize      BigInt?       @map("file_size")
  storageBucket String?       @map("storage_bucket")
  storageRegion String?       @map("storage_region")
  objectKey     String?       @map("object_key")
  sha256        String?
  version       String?
  mimeType      String?       @map("mime_type")
  downloadCount Int           @default(0) @map("download_count")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  tool          Tool?         @relation("ToolFiles", fields: [toolId], references: [id])
  primaryFor    Tool?         @relation("PrimaryDownload")
  downloadLogs  DownloadLog[]
  orderVersions Order[]       @relation("OrderToolFile")
  toolPurchases ToolPurchase[] @relation("ToolPurchaseFile")
  workflowCandidate AiWorkflowCandidate?
  aiWorkflowDownloadEvents AiWorkflowDownloadEvent[]
  workflowVersionPurchases AiWorkflowVersionPurchase[]

  @@map("files")
}

model Tutorial {
  id           String        @id @default(cuid())
  toolId       String        @map("tool_id")
  title        String
  content      String
  imageUrl     String?       @map("image_url")
  videoUrl     String?       @map("video_url")
  notes        String?
  commonErrors String?       @map("common_errors")
  sortOrder    Int           @default(0) @map("sort_order")
  status       ContentStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  tool         Tool          @relation(fields: [toolId], references: [id])

  @@index([toolId, status])
  @@map("tutorials")
}

model Order {
  id                        String                     @id @default(cuid())
  orderNo                   String                     @unique @map("order_no")
  userId                    String                     @map("user_id")
  planId                    String?                    @map("plan_id")
  toolId                    String?                    @map("tool_id")
  toolFileId                String?                    @map("tool_file_id")
  toolPriceSpecId           String?                    @map("tool_price_spec_id")
  toolPriceSpecName         String?                    @map("tool_price_spec_name")
  seoAuditOfferId           String?                    @map("seo_audit_offer_id")
  seoAuditTargetOrigin      String?                    @map("seo_audit_target_origin")
  seoAuditSourceRunId       String?                    @map("seo_audit_source_run_id")
  orderType                 OrderType                  @default(vip) @map("order_type")
  amount                    Decimal                    @db.Decimal(10, 2)
  paymentMethod             PaymentMethod?             @map("payment_method")
  orderStatus               OrderStatus                @default(pending_payment) @map("order_status")
  isTestData                Boolean                    @default(false) @map("is_test_data")
  paidAt                    DateTime?                  @map("paid_at")
  activatedAt               DateTime?                  @map("activated_at")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  user                      User                       @relation(fields: [userId], references: [id])
  plan                      VipPlan?                   @relation(fields: [planId], references: [id])
  tool                      Tool?                      @relation(fields: [toolId], references: [id], onDelete: Restrict)
  toolFile                  File?                      @relation("OrderToolFile", fields: [toolFileId], references: [id], onDelete: Restrict)
  toolPriceSpec             ToolPriceSpec?             @relation(fields: [toolPriceSpecId], references: [id], onDelete: Restrict)
  seoAuditOffer             SeoAuditOffer?             @relation(fields: [seoAuditOfferId], references: [id], onDelete: SetNull)
  seoAuditSourceRun         SeoAuditRun?               @relation("SeoAuditUpgradeSourceRun", fields: [seoAuditSourceRunId], references: [id], onDelete: SetNull)
  paymentProof              PaymentProof?
  paymentTransaction        PaymentTransaction?
  toolPurchase              ToolPurchase?
  aiWorkflowVersionPurchase AiWorkflowVersionPurchase?
  seoAuditCredit            SeoAuditCredit?
  seoAuditSubscriptionOrder SeoAuditSubscriptionOrder?
  seoAuditRuns              SeoAuditRun[]              @relation("SeoAuditFundedRuns")
  refundRecords             OrderRefundRecord[]

  @@index([userId, orderStatus])
  @@index([toolId, orderStatus])
  @@index([seoAuditOfferId, orderStatus])
  @@index([seoAuditSourceRunId])
  @@map("orders")
}

model PaymentTransaction {
  id                        String                   @id @default(cuid())
  orderId                   String                   @unique @map("order_id")
  provider                  String                   @default("zpay")
  providerTradeNo           String?                  @map("provider_trade_no")
  providerOrderId           String?                  @map("provider_order_id")
  paymentType               String                   @map("payment_type")
  status                    PaymentTransactionStatus @default(pending)
  amount                    Decimal                  @db.Decimal(10, 2)
  qrCodeUrl                 String?                  @map("qr_code_url")
  qrImageUrl                String?                  @map("qr_image_url")
  payUrl                    String?                  @map("pay_url")
  payUrl2                   String?                  @map("pay_url2")
  rawResponse               Json?                    @map("raw_response")
  notifyPayload             Json?                    @map("notify_payload")
  refundPayload             Json?                    @map("refund_payload")
  refundState               PaymentRefundState?      @map("refund_state")
  refundRecordId            String?                  @unique @map("refund_record_id")
  refundDispatchCount       Int                      @default(0) @map("refund_dispatch_count")
  refundRequestedAt         DateTime?                @map("refund_requested_at")
  refundDispatchStartedAt   DateTime?                @map("refund_dispatch_started_at")
  refundProviderRespondedAt DateTime?                @map("refund_provider_responded_at")
  refundProviderReference   String?                  @map("refund_provider_reference")
  refundLastErrorCode       String?                  @map("refund_last_error_code")
  refundLastErrorDetail     String?                  @map("refund_last_error_detail")
  paidAt                    DateTime?                @map("paid_at")
  refundedAt                DateTime?                @map("refunded_at")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  order                     Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refundRecord              OrderRefundRecord?       @relation(fields: [refundRecordId], references: [id], onDelete: Restrict)

  @@unique([provider, refundProviderReference])
  @@index([providerTradeNo])
  @@index([status])
  @@index([refundState, refundDispatchStartedAt], map: "payment_transactions_refund_state_refund_dispatch_started_at_id")
  @@map("payment_transactions")
}

model OrderRefundRecord {
  id                 String              @id @default(cuid())
  orderId            String              @map("order_id")
  adminId            String?             @map("admin_id")
  requesterId        String?             @map("requester_id")
  amount             Decimal             @db.Decimal(10, 2)
  status             RefundStatus        @default(completed)
  reason             String
  note               String?
  refundReceiverQr   String?             @map("refund_receiver_qr")
  refundProofImage   String?             @map("refund_proof_image")
  completedAt        DateTime?           @map("completed_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  admin              User?               @relation("RefundAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  requester          User?               @relation("RefundRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  paymentTransaction PaymentTransaction?

  @@index([orderId, createdAt])
  @@index([adminId, createdAt])
  @@index([requesterId, createdAt])
  @@map("order_refund_records")
}

model ToolPurchase {
  id                String         @id @default(cuid())
  userId            String         @map("user_id")
  toolId            String         @map("tool_id")
  toolPriceSpecId   String?        @map("tool_price_spec_id")
  toolPriceSpecName String?        @map("tool_price_spec_name")
  fileId            String?        @map("file_id")
  orderId           String         @unique @map("order_id")
  amount            Decimal        @db.Decimal(10, 2)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  user              User           @relation(fields: [userId], references: [id])
  tool              Tool           @relation(fields: [toolId], references: [id])
  toolPriceSpec     ToolPriceSpec? @relation(fields: [toolPriceSpecId], references: [id], onDelete: Restrict)
  order             Order          @relation(fields: [orderId], references: [id])
  file              File?          @relation("ToolPurchaseFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([userId, toolId])
  @@map("tool_purchases")
}

model AiWorkflowTopic {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  englishName String?              @map("english_name")
  sortOrder   Int                  @default(0) @map("sort_order")
  isEnabled   Boolean              @default(true) @map("is_enabled")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  batches     AiWorkflowBatch[]
  candidates  AiWorkflowCandidate[]

  @@index([isEnabled, sortOrder])
  @@map("ai_workflow_topics")
}

model AiWorkflowCollectionSetting {
  id                       String    @id @default("default")
  isEnabled                Boolean   @default(false) @map("is_enabled")
  isPaused                 Boolean   @default(false) @map("is_paused")
  scheduleTime             String    @default("09:00") @map("schedule_time")
  timeZone                 String    @default("Asia/Shanghai") @map("time_zone")
  topicListVersion         Int       @default(0) @map("topic_list_version")
  topicListConfirmedAt     DateTime? @map("topic_list_confirmed_at")
  scheduledTaskRegisteredAt DateTime? @map("scheduled_task_registered_at")
  scheduledTaskEnabledAt   DateTime? @map("scheduled_task_enabled_at")
  firstUnattendedSuccessAt DateTime? @map("first_unattended_success_at")
  lastWorkerSeenAt         DateTime? @map("last_worker_seen_at")
  lastSuccessfulRunAt      DateTime? @map("last_successful_run_at")
